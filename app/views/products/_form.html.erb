<%= form_with model: product do |f| %>
  <% if product.errors.any? %>
    <div class="errors" role="alert">
      <strong>No se pudo guardar el producto:</strong>
      <ul>
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :nombre, "Nombre" %>
    <%= f.text_field :nombre, required: true, maxlength: 100 %>
  </div>

  <div class="field">
    <%= f.label :descripcion, "Descripción" %>
    <%= f.text_area :descripcion, maxlength: 500 %>
  </div>

  <div class="row">
    <div class="field">
      <%= f.label :precio, "Precio" %>
      <%= f.number_field :precio, required: true, min: 0, step: "0.01", value: precio_input(product.precio) %>
    </div>
    <div class="field">
      <%= f.label :cantidad, "Cantidad" %>
      <%= f.number_field :cantidad, required: true, min: 0, step: 1 %>
    </div>
  </div>

  <div class="actions">
    <%= f.submit product.persisted? ? "Guardar cambios" : "Crear producto", class: "btn btn-primary" %>
    <%= link_to "Cancelar", product.persisted? ? product_path(product.id) : products_path, class: "btn" %>
  </div>
<% end %>
