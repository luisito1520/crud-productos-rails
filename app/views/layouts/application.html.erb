<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for?(:title) ? "#{yield(:title)} · " : "" %>Registro de Productos</title>
  <%= csrf_meta_tags %>
  <style>
    :root {
      --bg: #f5f6fa; --surface: #fff; --text: #1d2130; --muted: #646b80;
      --border: #dde0ea; --primary: #2b3a8c; --primary-hover: #1f2b6b;
      --danger: #b42318; --danger-bg: #fdecea; --ok: #146c43; --ok-bg: #e7f6ee;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--text);
           font: 15px/1.5 system-ui, "Segoe UI", Roboto, Arial, sans-serif; }
    a { color: var(--primary); }
    header { background: var(--primary); color: #fff; }
    header .wrap { display: flex; align-items: center; justify-content: space-between; padding-block: 14px; }
    header a { color: #fff; text-decoration: none; font-weight: 600; font-size: 1.1rem; }
    .wrap { max-width: 960px; margin: 0 auto; padding-inline: 16px; }
    main { padding-block: 28px; }
    h1 { font-size: 1.5rem; margin: 0 0 18px; }
    .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
    .toolbar h1 { margin: 0; }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 22px; }
    .btn { display: inline-block; border: 1px solid var(--border); background: var(--surface); color: var(--text);
           padding: 7px 14px; border-radius: 7px; font: inherit; font-size: .9rem; cursor: pointer; text-decoration: none; }
    .btn:hover { background: #eef0f6; }
    .btn-primary { background: var(--primary); border-color: var(--primary); color: #fff; }
    .btn-primary:hover { background: var(--primary-hover); }
    .btn-danger { color: var(--danger); border-color: #f1c4bf; }
    .btn-danger:hover { background: var(--danger-bg); }
    .actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .actions form { margin: 0; }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border); vertical-align: middle; }
    th { font-size: .8rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
    td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
    tr:last-child td { border-bottom: 0; }
    .muted { color: var(--muted); }
    .empty { text-align: center; padding: 40px 0; }
    .flash { padding: 10px 14px; border-radius: 8px; margin-bottom: 18px; }
    .flash.notice { background: var(--ok-bg); color: var(--ok); }
    .flash.alert { background: var(--danger-bg); color: var(--danger); }
    .field { margin-bottom: 16px; }
    .field label { display: block; font-weight: 600; margin-bottom: 5px; }
    .field input, .field textarea { width: 100%; padding: 9px 11px; border: 1px solid var(--border);
           border-radius: 7px; font: inherit; background: #fff; }
    .field textarea { min-height: 90px; resize: vertical; }
    .field input:focus, .field textarea:focus { outline: 2px solid #9aa6e0; border-color: var(--primary); }
    .field_with_errors input, .field_with_errors textarea { border-color: var(--danger); }
    .field_with_errors label { color: var(--danger); }
    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .errors { background: var(--danger-bg); color: var(--danger); border-radius: 8px; padding: 12px 16px; margin-bottom: 18px; }
    .errors ul { margin: 6px 0 0; padding-left: 20px; }
    dl { display: grid; grid-template-columns: 140px 1fr; gap: 10px 16px; margin: 0 0 22px; }
    dt { font-weight: 600; color: var(--muted); }
    dd { margin: 0; }
    @media (max-width: 600px) {
      .row { grid-template-columns: 1fr; }
      dl { grid-template-columns: 1fr; gap: 2px; }
      dd { margin-bottom: 10px; }
    }
  </style>
</head>
<body>
  <header>
    <div class="wrap">
      <%= link_to "Registro de Productos", root_path %>
    </div>
  </header>
  <main class="wrap">
    <% flash.each do |type, message| %>
      <div class="flash <%= type %>" role="status"><%= message %></div>
    <% end %>
    <%= yield %>
  </main>
</body>
</html>
